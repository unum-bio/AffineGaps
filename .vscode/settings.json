{
  "[mojo]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },
  "cSpell.words": [
    "ARNDCQEGHILKMFPSTWYVBZX",
    "Alexandros",
    "BLOSUM",
    "Bioinformatics",
    "Bleasby",
    "Flouri",
    "GATTACA",
    "GCATGCU",
    "GIVEQCCTSICSLYQLENYCN",
    "Gotoh",
    "Gusfield",
    "HSQGTFTSDYSKYLDSRAEQDFV",
    "Kassian",
    "Kobert",
    "Needleman",
    "Osamu",
    "Rognes",
    "Smith",
    "Stamatakis",
    "Torbjørn",
    "Vardanian",
    "Waterman",
    "Wunsch",
    "affinegaps",
    "backtracking",
    "biopy",
    "biopython",
    "conftest",
    "dtype",
    "hatchling",
    "levenshtein",
    "ndarray",
    "nopython",
    "numba",
    "patchelf",
    "pixi",
    "ptxas",
    "pyproject",
    "pytest",
    "stringzilla"
  ],
  "editor.rulers": [
    120
  ],
  "files.associations": {
    "*.mojo": "mojo",
    "pixi.toml": "toml"
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python",
  "python.testing.pytestArgs": [
    "test.py"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "editor.detectIndentation": false,
  "[json]": {
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.tabSize": 2
  },
  "[toml]": {
    "editor.tabSize": 2
  }
}
